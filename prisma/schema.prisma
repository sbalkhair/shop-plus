generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String           @id
  name            String
  email           String
  emailVerified   Boolean          @default(false)
  image           String?
  phone           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  sessions        Session[]
  accounts        Account[]
  orders          Order[]
  addresses       Address[]
  isAdmin         Boolean          @default(false)
  isDriver        Boolean          @default(false)
  deliveryPartner DeliveryPartner?

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Product {
  id            String   @id @default(uuid())
  name          String
  description   String?  @default("")
  price         Float
  originalPrice Float?   @default(0)
  image         String
  category      String
  categoryInfo  Category @relation(fields: [category], references: [slug], onDelete: Restrict, onUpdate: Cascade)
  unit          String?  @default("piece")
  stock         Int?     @default(0)
  isOrganic     Boolean? @default(false)
  rating        Float?   @default(0)
  reviewCount   Int?     @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category])
}

/// Product categories are managed from the admin dashboard. `slug` is the
/// stable value stored on `Product.category`, so renaming a category cascades
/// to every product and deleting one is blocked while products still use it.
model Category {
  id        String    @id @default(uuid())
  slug      String    @unique
  name      String
  image     String    @default("")
  sortOrder Int       @default(100)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@map("category")
}

model Order {
  id              String @id @default(uuid())
  userId          String
  user            User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  items           Json
  shippingAddress Json
  paymentMethod   String @default("card")
  subtotal        Float
  deliveryFee     Float? @default(0)
  tax             Float? @default(0)
  total           Float
  status          String @default("Placed")
  statusHistory   Json

  deliveryPartnerId String?
  deliveryPartner   DeliveryPartner? @relation(fields: [deliveryPartnerId], references: [id], onDelete: SetNull)
  liveLocation      Json?
  isPaid            Boolean?         @default(false)
  paidAt            DateTime?

  payments             Payment[]
  deliveryVerification DeliveryVerification?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deliveryPartnerId, status, createdAt])
  @@index([status, createdAt])
  @@index([userId, createdAt])
}

/// Customer delivery addresses. A customer can save multiple addresses and
/// mark one as the default used at checkout. The "at most one default per user"
/// invariant is maintained transactionally by the addresses API.
model Address {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String   @default("Home")
  fullName  String
  phone     String
  email     String   @default("")
  address   String
  city      String
  state     String
  zip       String
  /// Optional map pin chosen with Leaflet at checkout / in the address book.
  latitude  Float?
  longitude Float?
  notes     String   @default("")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("address")
}

/// A single online payment attempt for an order.
///
/// `id` is generated by the server *before* the payment intent is created and
/// is also sent to Moyasar as `given_id`. That makes the Moyasar payment id
/// deterministic for this attempt and keeps retries idempotent.
///
/// `activeOrderId` is a nullable unique column used to enforce "at most one
/// active payment attempt per order" at the database level. It is set to the
/// order id while the attempt is active and cleared once the attempt reaches a
/// terminal state.
model Payment {
  id      String @id
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// Set while this attempt is the active one for the order. Unique per order.
  activeOrderId String? @unique

  provider String @default("moyasar")

  moyasarIntentId  String? @unique
  moyasarPaymentId String? @unique

  /// Amount in the smallest currency unit (halalas).
  amount   Int
  currency String @default("SAR")

  /// Internal lifecycle status. Kept separate from Moyasar's raw status.
  status         String  @default("creating")
  providerStatus String?

  /// Sanitized payment-method details. Never card numbers, CVC, or expiry.
  method   String?
  network  String?
  lastFour String?

  failureCode    String?
  failureMessage String?

  /// Only sanitized, non-sensitive values are stored here.
  metadata Json?

  intentExpiresAt DateTime?
  paidAt          DateTime?
  refundedAt      DateTime?
  voidedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([status])
  @@map("payment")
}

model DeliveryPartner {
  id                 String                 @id @default(uuid())
  name               String
  email              String                 @unique
  phone              String
  avatar             String?                @default("")
  vehicleType        String?                @default("bike")
  isActive           Boolean?               @default(true)
  orders             Order[]
  userId             String?                @unique
  user               User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  verifiedDeliveries DeliveryVerification[] @relation("VerifiedDeliveries")
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
}

/// One delivery verification per order. The plaintext OTP is never stored.
///
/// `codeHash` is an HMAC-SHA-256 of the six-digit code so verification is
/// constant-time and a leaked database cannot be brute-forced cheaply.
/// `codeEncrypted` is AES-256-GCM ciphertext of the same code and is only
/// decrypted when the order owner needs to see it on the tracking page.
model DeliveryVerification {
  id      String @id @default(uuid())
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  codeHash      String
  codeEncrypted String

  expiresAt                   DateTime
  verifiedAt                  DateTime?
  attempts                    Int              @default(0)
  lastAttemptAt               DateTime?
  verifiedByDeliveryPartnerId String?
  verifiedByDeliveryPartner   DeliveryPartner? @relation("VerifiedDeliveries", fields: [verifiedByDeliveryPartnerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
  @@map("delivery_verification")
}
