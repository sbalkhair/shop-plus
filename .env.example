# PostgreSQL connection string used by Prisma CLI and Prisma Client.
DATABASE_URL="postgresql://user:password@localhost:5432/shop_plus?schema=public"
# UploadThing v7 uses a single token from https://uploadthing.com/dashboard.
# Never commit real credentials.
UPLOADTHING_TOKEN="your-uploadthing-token"
# Legacy v6 secret. The v7 SDK uses UPLOADTHING_TOKEN and ignores this value.
# UPLOADTHING_SECRET="your-uploadthing-secret"

# ---------------------------------------------------------------------------
# Moyasar (sandbox only)
# ---------------------------------------------------------------------------
# Use test keys only. The integration refuses live keys so a misconfiguration
# cannot charge a real card while it is being validated.
#
# IMPORTANT: MOYASAR_SECRET_KEY and MOYASAR_WEBHOOK_SECRET are server-side
# secrets. Never prefix them with VITE_ and never expose them to the browser.
MOYASAR_PUBLISHABLE_KEY="pk_test_your_publishable_key"
MOYASAR_SECRET_KEY="sk_test_your_secret_key"

# A long random password that you also enter in the Moyasar dashboard under
# Settings -> Webhooks -> Secret Token.
# Generate one with: openssl rand -hex 32
MOYASAR_WEBHOOK_SECRET="replace-with-a-long-random-secret"

# Optional. Public HTTPS URL for the return page. Must NOT be localhost or a
# private IP: Moyasar rejects those. Get a public URL with `bun run dev:tunnel`.
# MOYASAR_CALLBACK_URL="https://your-tunnel.example.com/payment-result"

# Optional. Public origin used by better-auth when testing through a tunnel.
# The `bun run dev:tunnel` script sets this automatically.
# BETTER_AUTH_URL="https://your-tunnel.example.com"

# Optional. Defaults to https://api.moyasar.com/v1
# MOYASAR_BASE_URL="https://api.moyasar.com/v1"

# ---------------------------------------------------------------------------
# Delivery OTP
# ---------------------------------------------------------------------------
# Server-side secret used to derive the HMAC and AES-256-GCM keys for delivery
# verification codes. Never prefix this with VITE_ and never expose it to the
# browser. Generate one with: openssl rand -hex 32
DELIVERY_OTP_SECRET="replace-with-a-long-random-secret"
# How long a delivery verification code is valid after it is generated.
DELIVERY_OTP_TTL_MINUTES=60
# Maximum failed verification attempts before the code is locked out.
DELIVERY_OTP_MAX_ATTEMPTS=5
